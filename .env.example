# Copy to .env.local and fill in from Supabase: Project Settings → API Keys.
# Both values are safe to ship in the app (row-level security protects the data).
# Without them, ApexPrep runs fully offline and never syncs.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Email-code sign-in needs a custom email sender in Supabase (docs/SUPABASE.md).
# Leave it off until that's set up; students sign in with Apple meanwhile.
# EXPO_PUBLIC_EMAIL_SIGN_IN=1
