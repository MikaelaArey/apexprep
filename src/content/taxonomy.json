  "traps": {
    "reversal": {
      "name": "Reversed condition",
      "desc": "Flips the logic: treats what's needed as a guarantee, or the reverse."
    },
    "out_of_scope": {
      "name": "Out of scope",
      "desc": "Brings in something the argument or passage never addresses."
    },
    "too_strong": {
      "name": "Too strong",
      "desc": "Goes further than the evidence supports (all, never, only)."
    },
    "too_weak": {
      "name": "Too weak",
      "desc": "True or relevant, but not strong enough to do the job."
    },
    "wrong_direction": {
      "name": "Wrong direction",
      "desc": "Does the opposite of what the question asks."
    },
    "restates_premise": {
      "name": "Restates a premise",
      "desc": "Repeats evidence instead of doing the question's task."
    },
    "irrelevant_comparison": {
      "name": "Irrelevant comparison",
      "desc": "Compares groups or things the argument doesn't depend on."
    },
    "doesnt_differentiate": {
      "name": "Doesn't separate the groups",
      "desc": "Affects both sides equally, so it can't explain a difference."
    },
    "not_present": {
      "name": "Not in the argument",
      "desc": "Describes a flaw or move the argument doesn't actually make."
    },
    "half_right": {
      "name": "Half right",
      "desc": "Starts correctly, then adds a part that's wrong or unsupported."
    },
    "deepens": {
      "name": "Deepens the puzzle",
      "desc": "Makes the discrepancy harder to explain, not easier."
    },
    "contradicts": {
      "name": "Contradicts the text",
      "desc": "Conflicts with something the stimulus or passage states."
    },
    "unsupported": {
      "name": "Could be true",
      "desc": "Might be true, but nothing in the text proves it."
    },
    "too_narrow": {
      "name": "Too narrow",
      "desc": "Covers one detail or paragraph, not the whole passage."
    },
    "wrong_viewpoint": {
      "name": "Wrong viewpoint",
      "desc": "Gives a view held by someone other than the one asked about."
    },
    "distortion": {
      "name": "Distortion",
      "desc": "Uses the passage's words but twists what they mean."
    },
    "sign_flip": {
      "name": "Flipped sign",
      "desc": "Right idea, wrong direction or sign (+/−, increase/decrease)."
    },
    "power_of_ten": {
      "name": "Unit or power-of-10 slip",
      "desc": "Dropped a unit conversion or an order of magnitude."
    },
    "lookalike": {
      "name": "Look-alike concept",
      "desc": "Confuses a similar-sounding concept, formula or structure."
    },
    "skipped_step": {
      "name": "Skipped step",
      "desc": "Stops one step short of the full calculation."
    },
    "misread_data": {
      "name": "Misread the data",
      "desc": "Pulls the wrong value from a table, graph or condition."
    },
    "true_irrelevant": {
      "name": "True but irrelevant",
      "desc": "A correct statement that doesn't answer this question."
    },
    "false_fact": {
      "name": "Factually wrong",
      "desc": "States something that isn't true about the science."
    },
    "overreach": {
      "name": "Overreach",
      "desc": "Claims more than the data or study design can show."
    },
    "different_structure": {
      "name": "Different structure",
      "desc": "Shares the topic or some wording, but not the pattern of reasoning."
    },
    "not_in_dispute": {
      "name": "Not in dispute",
      "desc": "Both speakers agree on it, or at least one never takes a side."
    }
  },
  "missReasons": {
    "didnt_know": "Didn't know it",
    "misread": "Misread",
    "timing": "Ran out of time",
    "changed": "Changed my answer",
    "narrowed": "Narrowed to two"
  }
}
